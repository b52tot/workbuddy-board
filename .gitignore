# ---------------------------------------------------------------- 运行时数据
# SQLite 库、WAL 文件 —— 是数据不是源码
data/
*.db
*.db-wal
*.db-shm

# ---------------------------------------------------------------- 本地配置
# 含个人机器上的绝对路径与端口，不应提交（模板见 config.example.json）
config.json

# ---------------------------------------------------------------- 构建产物
# ★ 构建产物一律不进版本库。
#   exe 走 GitHub Releases 分发 —— 它一旦进库，每更新一次就在历史里
#   多留一份 15MB（实测：5 个提交就让 .git 涨到 34MB）。
*.exe
widget/build/
widget/dist/

# 挂件运行时写出的窗口状态、自动生成的库路径、日志
widget/state.json
widget/board-config.json
widget/host.log
*.log

# ---------------------------------------------------------------- 备份与临时
*.bak
*.bak-*
*.orig
*.rej
.workbuddy/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
